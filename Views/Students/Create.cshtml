@model StudentFormViewModel
@{ ViewData["Title"] = "Add student"; ViewData["Section"] = "Add student"; }
<section class="page-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> PEOPLE &amp; RECORDS</div><h1>Add a student</h1><p class="lead">Create a student profile and connect them to a group.</p></div><a class="button button-quiet" asp-action="Index">← Back to directory</a></section>
<div class="form-layout"><section class="panel form-panel"><div class="form-title"><span class="form-icon">✦</span><div><h2>Student details</h2><p>Fields marked <b>*</b> are required.</p></div></div><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field"><label asp-for="Name">Full name <span>*</span></label><input asp-for="Name" class="form-control" placeholder="e.g. Alex Morgan" autocomplete="name" autofocus /><span asp-validation-for="Name" class="field-error"></span></div><div class="field"><label asp-for="Email">Email address <span>*</span></label><input asp-for="Email" class="form-control" placeholder="alex@university.edu" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span></div><div class="field"><label asp-for="GroupId">Academic group <span>*</span></label><select asp-for="GroupId" asp-items="Model.Groups" class="form-control"><option value="0">Select a group</option></select><span asp-validation-for="GroupId" class="field-error"></span></div><div class="form-actions"><a class="button button-quiet" asp-action="Index">Cancel</a><button type="submit" class="button button-primary">Save student <span>→</span></button></div></form></section><aside class="form-aside"><div class="aside-mark">✦</div><div class="panel-kicker">A GOOD PLACE TO START</div><h3>Every great campus has a strong community.</h3><p>Student records bring names, contact details, and academic groups together in one reliable place.</p><div class="aside-divider"></div><div class="aside-check"><span>✓</span><span><strong>Accurate by design</strong><small>Validated before saving</small></span></div><div class="aside-check"><span>✓</span><span><strong>Connected records</strong><small>Each student belongs to a group</small></span></div></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
