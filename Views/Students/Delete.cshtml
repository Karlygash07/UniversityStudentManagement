@model Student
@{ ViewData["Title"] = "Remove student"; ViewData["Section"] = "Remove student"; }
<section class="page-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> PEOPLE &amp; RECORDS</div><h1>Remove student</h1><p class="lead">Review this record before removing it from the directory.</p></div><a class="button button-quiet" asp-action="Index">← Back to directory</a></section>
<section class="panel delete-panel"><div class="delete-symbol">!</div><div class="panel-kicker">PLEASE CONFIRM</div><h2>Remove this student?</h2><p class="delete-copy">This will permanently remove the student profile from the directory. This action can't be undone.</p><div class="delete-profile"><span class="student-avatar avatar-@(Model.Id % 5)">@Model.Name.Trim().Substring(0, 1).ToUpperInvariant()</span><span><strong>@Model.Name</strong><small>@Model.Email</small></span><span class="group-pill"><span class="group-dot"></span>@Model.Group.Name</span></div><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><div class="form-actions"><a class="button button-quiet" asp-action="Index">Keep student</a><button type="submit" class="button button-danger">Remove student</button></div></form></section>
