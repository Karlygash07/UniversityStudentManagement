@model StudentIndexViewModel
@{ ViewData["Title"] = "Students"; ViewData["Section"] = "Students"; }
<section class="page-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> PEOPLE &amp; RECORDS</div><h1>Student directory</h1><p class="lead">Every student, thoughtfully organized.</p></div><a class="button button-primary" asp-action="Create"><span>＋</span> Add student</a></section>
<section class="directory-stats"><div><span class="mini-stat-icon violet">♙</span><span><strong>@Model.TotalStudents</strong><small>Total students</small></span></div><div><span class="mini-stat-icon cyan">◫</span><span><strong>@Model.TotalGroups</strong><small>Academic groups</small></span></div><div class="directory-tip"><span>✦</span> Keep your directory up to date</div></section>
<section class="panel directory-panel"><div class="directory-head"><div><h2>All students <span class="count-pill">@Model.Students.Count</span></h2><p>Manage student profiles and group assignments</p></div><form class="search-form" method="get" asp-action="Index"><label class="search-box"><span aria-hidden="true">⌕</span><input type="search" name="searchTerm" value="@Model.SearchTerm" placeholder="Search by student name..." aria-label="Search by student name" /><button type="submit">Search</button></label>@if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) { <a class="clear-search" asp-action="Index">Clear</a> }</form></div>
    @if (!Model.Students.Any()) { <div class="empty-state"><div class="empty-icon">@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "♙" : "⌕")</div><h3>@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "Your directory is ready" : "No students found")</h3><p>@(string.IsNullOrWhiteSpace(Model.SearchTerm) ? "Add your first student to begin building your directory." : $"We couldn't find anyone matching ‘{Model.SearchTerm}’. Try another name.")</p>@if (string.IsNullOrWhiteSpace(Model.SearchTerm)) { <a class="button button-primary" asp-action="Create">＋ Add your first student</a> } else { <a class="text-link" asp-action="Index">Clear search <span>→</span></a> }</div> }
    else { <div class="table-scroll"><table class="student-table"><thead><tr><th>STUDENT</th><th>EMAIL ADDRESS</th><th>ACADEMIC GROUP</th><th class="actions-column">ACTIONS</th></tr></thead><tbody>@foreach (var student in Model.Students) { <tr><td><div class="student-cell"><span class="student-avatar avatar-@(student.Id % 5)">@student.Name.Trim().Substring(0, 1).ToUpperInvariant()</span><span><strong>@student.Name</strong><small>Student ID · @student.Id.ToString("D4")</small></span></div></td><td><a class="email-link" href="mailto:@student.Email">@student.Email</a></td><td><span class="group-pill"><span class="group-dot"></span>@student.Group.Name</span></td><td><div class="row-actions"><a class="action-button" asp-action="Edit" asp-route-id="@student.Id" aria-label="Edit @student.Name" title="Edit student"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m13.8 3.2 3 3-9.5 9.5-4 .9.9-4zM12 5l3 3"/></svg></a><a class="action-button action-delete" asp-action="Delete" asp-route-id="@student.Id" aria-label="Delete @student.Name" title="Delete student"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4.5 6h11M8 6V4h4v2m2 0-.6 10h-7L5.8 6m2.7 3v4m3-4v4"/></svg></a></div></td></tr> }</tbody></table></div><div class="table-foot"><span>Showing <strong>@Model.Students.Count</strong>@(Model.SearchTerm is null ? $" of {Model.TotalStudents}" : " matching records") students</span><span class="table-foot-note"><span class="status-dot"></span> Directory up to date</span></div> }
</section>
