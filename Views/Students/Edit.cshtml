@model StudentFormViewModel
@{ ViewData["Title"] = "Edit student"; ViewData["Section"] = "Edit student"; }
<section class="page-heading"><div><div class="eyebrow"><span class="eyebrow-line"></span> PEOPLE &amp; RECORDS</div><h1>Edit student</h1><p class="lead">Update profile details and group assignment.</p></div><a class="button button-quiet" asp-action="Index">← Back to directory</a></section>
<div class="form-layout"><section class="panel form-panel"><div class="form-title"><span class="form-icon">✎</span><div><h2>Student details</h2><p>Student record <b>#@Model.Id.ToString("D4")</b></p></div></div><form asp-action="Edit" asp-route-id="@Model.Id" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field"><label asp-for="Name">Full name <span>*</span></label><input asp-for="Name" class="form-control" autocomplete="name" autofocus /><span asp-validation-for="Name" class="field-error"></span></div><div class="field"><label asp-for="Email">Email address <span>*</span></label><input asp-for="Email" class="form-control" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span></div><div class="field"><label asp-for="GroupId">Academic group <span>*</span></label><select asp-for="GroupId" asp-items="Model.Groups" class="form-control"><option value="0">Select a group</option></select><span asp-validation-for="GroupId" class="field-error"></span></div><div class="form-actions"><a class="button button-quiet" asp-action="Index">Cancel</a><button type="submit" class="button button-primary">Save changes <span>→</span></button></div></form></section><aside class="form-aside"><div class="aside-mark">✦</div><div class="panel-kicker">PROFILE UPDATE</div><h3>Small details make a big difference.</h3><p>Keep contact information current so every record stays useful to your university team.</p><div class="aside-divider"></div><div class="aside-check"><span>✓</span><span><strong>Changes are validated</strong><small>Your record is checked before saving</small></span></div></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
