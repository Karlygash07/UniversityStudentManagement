<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f8faff" />
    <title>@ViewData["Title"] · UniFlow</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="UniFlow home">
                <span class="brand-mark"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M7 7.5h18M7 13h18M7 18.5h11M7 24h11"/><circle cx="23" cy="22" r="5"/><path d="m21 22 1.4 1.4L25.5 20"/></svg></span>
                <span>uni<span class="brand-accent">flow</span><small>STUDENT MANAGEMENT</small></span>
            </a>
            <div class="nav-caption">WORKSPACE</div>
            <nav class="side-nav" aria-label="Main navigation">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index"><span class="nav-icon">⌂</span> Overview</a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Students" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Students" asp-action="Index"><span class="nav-icon">▤</span> Students</a>
                <a class="nav-link" asp-controller="Students" asp-action="Create"><span class="nav-icon">＋</span> Add student</a>
            </nav>
            <div class="sidebar-bottom"><div class="help-card"><div class="help-orb">✦</div><strong>Everything in sync</strong><p>Your student records, all in one considered space.</p></div><div class="sidebar-foot"><span class="status-dot"></span> Academic workspace</div></div>
        </aside>
        <main class="main-area">
            <header class="topbar"><button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation" aria-expanded="false">☰</button><div class="breadcrumb"><span>Workspace</span><i>/</i><strong>@ViewData["Section"]</strong></div><div class="topbar-right"><span class="topbar-label">UNIVERSITY ADMINISTRATION</span><span class="avatar">U</span></div></header>
            <div class="page-wrap">
                @if (TempData["Success"] is string success) { <div class="toast toast-success" role="status"><span>✓</span>@success<button class="toast-close" aria-label="Dismiss">×</button></div> }
                @if (TempData["Error"] is string error) { <div class="toast toast-error" role="alert"><span>!</span>@error<button class="toast-close" aria-label="Dismiss">×</button></div> }
                @RenderBody()
                <footer class="page-footer"><span>© @DateTime.Now.Year UniFlow</span><span>Thoughtful tools for brighter futures <b>✦</b></span></footer>
            </div>
        </main>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
